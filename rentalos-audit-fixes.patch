diff --git a/src/lib/product.functions.ts b/src/lib/product.functions.ts
new file mode 100644
index 0000000..00a0c49
--- /dev/null
+++ b/src/lib/product.functions.ts
@@ -0,0 +1,101 @@
+import { createServerFn } from "@tanstack/react-start";
+import { z } from "zod";
+import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+async function assertAdmin(supabase: any, userId: string) {
+  const { data, error } = await supabase.from("admin_users").select("id").eq("user_id", userId).eq("active", true).maybeSingle();
+  if (error) throw new Error(error.message);
+  if (!data) throw new Error("Forbidden");
+}
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+async function roleOf(_supabase: any, userId: string): Promise<"landlord" | "tenant"> {
+  const { getAdmin } = await import("./whatsapp/db");
+  const { isLandlord } = await import("./mobile-landlord.server");
+  return (await isLandlord(await getAdmin(), userId)) ? "landlord" : "tenant";
+}
+
+export const trackProductEvent = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((i) => z.object({ event: z.string().max(60), props: z.record(z.string(), z.any()).optional() }).parse(i))
+  .handler(async ({ data, context }) => {
+    const { trackEvent } = await import("./product.server");
+    await trackEvent(context.userId, data.event, { role: await roleOf(context.supabase, context.userId), platform: "web", props: data.props });
+    return { ok: true };
+  });
+
+export const submitFeedback = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((i) =>
+    z.object({ kind: z.enum(["bug", "idea", "support", "other"]), body: z.string().min(3).max(2000), screen: z.string().max(120).optional() }).parse(i),
+  )
+  .handler(async ({ data, context }) => {
+    const P = await import("./product.server");
+    return P.saveFeedback(context.userId, P.parseFeedback({ ...data, platform: "web" }, await roleOf(context.supabase, context.userId)));
+  });
+
+export const adminListFeedback = createServerFn({ method: "GET" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((i) => z.object({ status: z.enum(["open", "in_progress", "resolved", "wont_fix", "all"]).default("open") }).parse(i ?? {}))
+  .handler(async ({ data, context }) => {
+    await assertAdmin(context.supabase, context.userId);
+    const { getAdmin } = await import("./whatsapp/db");
+    const admin = await getAdmin();
+    let q = admin
+      .from("feedback_items")
+      .select("id, role, kind, body, screen, platform, app_version, status, admin_notes, created_at")
+      .order("created_at", { ascending: false })
+      .limit(200);
+    if (data.status !== "all") q = q.eq("status", data.status);
+    const { data: rows, error } = await q;
+    if (error) throw new Error("Couldn't load feedback.");
+    return { items: rows ?? [] };
+  });
+
+export const adminUpdateFeedback = createServerFn({ method: "POST" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((i) =>
+    z.object({ id: z.string().uuid(), status: z.enum(["open", "in_progress", "resolved", "wont_fix"]), notes: z.string().max(2000).optional() }).parse(i),
+  )
+  .handler(async ({ data, context }) => {
+    await assertAdmin(context.supabase, context.userId);
+    const { getAdmin } = await import("./whatsapp/db");
+    const admin = await getAdmin();
+    const patch: Record<string, unknown> = { status: data.status, updated_at: new Date().toISOString() };
+    if (data.notes !== undefined) patch.admin_notes = data.notes;
+    const { error } = await admin.from("feedback_items").update(patch).eq("id", data.id);
+    if (error) throw new Error("Couldn't update.");
+    return { ok: true };
+  });
+
+/** Admin: activation funnel + event counts for the last N days (distinct users per step). */
+export const adminFunnel = createServerFn({ method: "GET" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((i) => z.object({ days: z.number().int().min(1).max(90).default(30) }).parse(i ?? {}))
+  .handler(async ({ data, context }) => {
+    await assertAdmin(context.supabase, context.userId);
+    const { getAdmin } = await import("./whatsapp/db");
+    const admin = await getAdmin();
+    const since = new Date(Date.now() - data.days * 86400_000).toISOString();
+    const { data: rows, error } = await admin
+      .from("product_events")
+      .select("user_id, event, role")
+      .gte("created_at", since)
+      .limit(50000);
+    if (error) throw new Error("Couldn't load analytics.");
+    const users: Record<string, Set<string>> = {};
+    const totals: Record<string, number> = {};
+    for (const r of (rows ?? []) as { user_id: string | null; event: string }[]) {
+      totals[r.event] = (totals[r.event] ?? 0) + 1;
+      if (r.user_id) (users[r.event] ??= new Set()).add(r.user_id);
+    }
+    const steps = ["signup_completed", "onboarding_completed", "property_created", "room_created", "tenant_added", "bill_created", "payment_verified"];
+    return {
+      days: data.days,
+      truncated: (rows?.length ?? 0) >= 50000,
+      funnel: steps.map((e) => ({ event: e, users: users[e]?.size ?? 0 })),
+      totals,
+      activeUsers: new Set((rows ?? []).map((r: { user_id: string | null }) => r.user_id).filter(Boolean)).size,
+    };
+  });
diff --git a/src/lib/product.server.ts b/src/lib/product.server.ts
new file mode 100644
index 0000000..2377da7
--- /dev/null
+++ b/src/lib/product.server.ts
@@ -0,0 +1,101 @@
+/** First-party product analytics + feedback helpers (server only). No PII goes into event props. */
+import { getAdmin } from "./whatsapp/db";
+
+export const EVENT_NAMES = [
+  "app_open",
+  "signup_completed",
+  "onboarding_completed",
+  "property_created",
+  "room_created",
+  "tenant_added",
+  "bill_created",
+  "bill_shared",
+  "payment_submitted",
+  "payment_verified",
+  "feedback_opened",
+  "feedback_submitted",
+  "push_registered",
+] as const;
+export type EventName = (typeof EVENT_NAMES)[number];
+
+const ROLES = ["landlord", "tenant", "admin", "unknown"] as const;
+const PLATFORMS = ["web", "android", "ios", "server"] as const;
+export type Role = (typeof ROLES)[number];
+
+/** Keeps only short scalar props with safe keys — never free text, so no accidental PII. */
+export function sanitizeProps(p: unknown): Record<string, string | number | boolean> {
+  const out: Record<string, string | number | boolean> = {};
+  if (!p || typeof p !== "object") return out;
+  for (const [k, v] of Object.entries(p as Record<string, unknown>).slice(0, 8)) {
+    if (!/^[a-z_]{1,30}$/.test(k)) continue;
+    if (typeof v === "number" && Number.isFinite(v)) out[k] = v;
+    else if (typeof v === "boolean") out[k] = v;
+    else if (typeof v === "string" && /^[A-Za-z0-9_.\-]{1,40}$/.test(v)) out[k] = v;
+  }
+  return out;
+}
+
+/** Best-effort: analytics must never break a user action. */
+export async function trackEvent(
+  userId: string | null,
+  event: string,
+  opts: { role?: string; platform?: string; props?: unknown } = {},
+): Promise<void> {
+  try {
+    if (!(EVENT_NAMES as readonly string[]).includes(event)) return;
+    const role = (ROLES as readonly string[]).includes(opts.role ?? "") ? (opts.role as Role) : "unknown";
+    const platform = (PLATFORMS as readonly string[]).includes(opts.platform ?? "") ? opts.platform! : "server";
+    const admin = await getAdmin();
+    await admin.from("product_events").insert({ user_id: userId, role, event, platform, props: sanitizeProps(opts.props) });
+  } catch {
+    /* ignore */
+  }
+}
+
+const KINDS = ["bug", "idea", "support", "other"] as const;
+export type FeedbackInput = {
+  kind: (typeof KINDS)[number];
+  body: string;
+  screen: string | null;
+  platform: "web" | "android" | "ios";
+  appVersion: string | null;
+  role: Role;
+};
+
+export function parseFeedback(b: Record<string, unknown>, role: Role): FeedbackInput {
+  const kind = (KINDS as readonly string[]).includes(String(b.kind)) ? (b.kind as FeedbackInput["kind"]) : "other";
+  const body = typeof b.body === "string" ? b.body.trim().slice(0, 2000) : "";
+  if (body.length < 3) throw new Error("Please write at least a few words.");
+  const screen = typeof b.screen === "string" && b.screen.trim() ? b.screen.trim().slice(0, 120) : null;
+  const platform = b.platform === "ios" ? "ios" : b.platform === "android" ? "android" : "web";
+  const appVersion = typeof b.appVersion === "string" && b.appVersion.trim() ? b.appVersion.trim().slice(0, 40) : null;
+  return { kind, body, screen, platform, appVersion, role };
+}
+
+/** Max 5 submissions/hour/user so the inbox can't be flooded. */
+export async function saveFeedback(userId: string, f: FeedbackInput): Promise<{ id: string }> {
+  const admin = await getAdmin();
+  const since = new Date(Date.now() - 3600_000).toISOString();
+  const { count } = await admin
+    .from("feedback_items")
+    .select("id", { count: "exact", head: true })
+    .eq("user_id", userId)
+    .gte("created_at", since);
+  if ((count ?? 0) >= 5) throw new Error("Bahut zyada feedback bheja — thodi der baad try karein.");
+  const { data, error } = await admin
+    .from("feedback_items")
+    .insert({
+      user_id: userId,
+      role: f.role,
+      kind: f.kind,
+      body: f.body,
+      screen: f.screen,
+      platform: f.platform,
+      app_version: f.appVersion,
+    })
+    .select("id")
+    .single();
+  if (error || !data) throw new Error("Couldn't save feedback. Please try again.");
+  await trackEvent(userId, "feedback_submitted", { role: f.role, platform: f.platform, props: { kind: f.kind } });
+  return { id: data.id as string };
+}
