# Browser configuration: use the project's public Supabase URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server only. Never use VITE_ or EXPO_PUBLIC_ prefixes for secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://www.rentalos.in

# Official Meta WhatsApp Cloud API. See docs/whatsapp-setup.md.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=v25.0
META_TEMPLATE_LANGUAGE=en_US
# Set this only after the authentication template is APPROVED in Meta.
META_WHATSAPP_AUTH_TEMPLATE=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Must also be set as a GitHub Actions secret of the same name.
WHATSAPP_DISPATCH_SECRET=
