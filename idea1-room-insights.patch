+/* eslint-disable @typescript-eslint/no-explicit-any -- loosely typed service-role client */
+import { createServerFn } from "@tanstack/react-start";
+import { getRequestHeader } from "@tanstack/react-start/server";
+import { z } from "zod";
+import { requireSupabaseAuth } from "@/integrations/supabase/auth-middleware";
+
+/** Public: called by the room page after it renders. Optional token lets us skip the owner's own views. */
+export const recordRoomView = createServerFn({ method: "POST" })
+  .inputValidator((i) => z.object({ room_id: z.string().uuid(), token: z.string().max(4000).optional() }).parse(i))
+  .handler(async ({ data }) => {
+    const { getAdmin } = await import("./whatsapp/db");
+    const { recordView } = await import("./insights.server");
+    const admin: any = await getAdmin();
+    let userId: string | null = null;
+    if (data.token) {
+      const { data: u } = await admin.auth.getUser(data.token);
+      userId = u?.user?.id ?? null;
+    }
+    const xf = getRequestHeader("x-forwarded-for");
+    const ip = xf?.split(",")[0]?.trim() || getRequestHeader("x-real-ip") || null;
+    const counted = await recordView(admin, { roomId: data.room_id, userId, ip, ua: getRequestHeader("user-agent") ?? null });
+    return { ok: true, counted };
+  });
+
+export const getMyRoomInsights = createServerFn({ method: "GET" })
+  .middleware([requireSupabaseAuth])
+  .inputValidator((i) => z.object({ days: z.number().int().min(1).max(90).default(7) }).parse(i ?? {}))
+  .handler(async ({ data, context }) => {
+    const { getAdmin } = await import("./whatsapp/db");
+    const { getInsights } = await import("./insights.server");
+    return getInsights(await getAdmin(), context.userId, data.days);
+  });
diff --git a/src/lib/insights.server.ts b/src/lib/insights.server.ts
new file mode 100644
index 0000000..f224df2
--- /dev/null
+++ b/src/lib/insights.server.ts
@@ -0,0 +1,51 @@
+/* eslint-disable @typescript-eslint/no-explicit-any -- loosely typed service-role client */
+/**
+ * Landlord visit insights — thin server layer over supabase/migrations/20261116000000_room_views_insights.sql.
+ * Privacy: raw IPs are never stored. Anonymous viewers are a salted SHA-256 of ip+user-agent (one-way);
+ * landlords only ever receive counts, never who viewed.
+ */
+
+const BOT_RE = /bot|crawl|spider|slurp|preview|facebookexternalhit|whatsapp|telegram|curl|wget|python-requests|headless|lighthouse|monitor|uptime|go-http-client|axios|node-fetch/i;
+
+export function isBotUA(ua: string | null | undefined): boolean {
+  if (!ua || ua.length < 8) return true;
+  return BOT_RE.test(ua);
+}
+
+async function sha256Hex(s: string): Promise<string> {
+  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s));
+  return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+/** Signed-in users are keyed by user id; anonymous visitors by a salted one-way hash (never the raw IP). */
+export async function viewerKey(input: { userId?: string | null; ip?: string | null; ua?: string | null }): Promise<string> {
+  if (input.userId) return `u:${input.userId}`;
+  const salt = process.env.VIEW_HASH_SECRET || process.env.SUPABASE_SERVICE_ROLE_KEY || "rentalos-views";
+  return `a:${(await sha256Hex(`${salt}|${input.ip ?? ""}|${input.ua ?? ""}`)).slice(0, 32)}`;
+}
+
+/** Records one (de-duplicated) view. Never throws — analytics must not break a page. Returns whether it counted. */
+export async function recordView(
+  admin: any,
+  args: { roomId: string; userId?: string | null; ip?: string | null; ua?: string | null },
+): Promise<boolean> {
+  try {
+    if (isBotUA(args.ua)) return false;
+    const key = await viewerKey(args);
+    const { data, error } = await admin.rpc("record_room_view", { _room: args.roomId, _viewer: key, _viewer_user: args.userId ?? null });
+    return !error && data === true;
+  } catch {
+    return false;
+  }
+}
+
+export async function getInsights(admin: any, ownerId: string, days = 7) {
+  const d = days === 30 ? 30 : 7;
+  const { data, error } = await admin.rpc("room_insights", { _owner: ownerId, _days: d });
+  if (error) throw new Error("Couldn't load insights.");
+  return data as {
+    days: number;
+    totals: { views: number; prev_views: number; saves: number; requests: number; offers: number; public_rooms: number };
+    rooms: { room_id: string; label: string; views: number; saves: number; requests: number }[];
+  };
+}
