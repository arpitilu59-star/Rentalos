diff --git a/supabase/migrations/20261116000000_room_views_insights.sql b/supabase/migrations/20261116000000_room_views_insights.sql
new file mode 100644
index 0000000..e800c5a
--- /dev/null
+++ b/supabase/migrations/20261116000000_room_views_insights.sql
@@ -0,0 +1,114 @@
+-- Landlord "visit insights": real, de-duplicated room views + a weekly summary notification.
+-- Privacy: raw IPs are never stored (the server stores an opaque hashed key); landlords only ever see COUNTS.
+
+create table if not exists public.room_views (
+  room_id uuid not null references public.rooms(id) on delete cascade,
+  viewer_key text not null check (char_length(viewer_key) between 3 and 80),
+  day date not null default ((now() at time zone 'Asia/Kolkata')::date),
+  created_at timestamptz not null default now(),
+  primary key (room_id, viewer_key, day)  -- one view per viewer per room per day
+);
+create index if not exists idx_room_views_room_day on public.room_views (room_id, day desc);
+create index if not exists idx_room_views_viewer_day on public.room_views (viewer_key, day);
+alter table public.room_views enable row level security; -- no policies: server (service role) only
+revoke all on public.room_views from anon, authenticated;
+grant all on public.room_views to service_role;
+
+-- Record a view. Ignores: the owner's own views, non-public rooms, and a viewer who has already hit 200 rooms today (scripts).
+create or replace function public.record_room_view(_room uuid, _viewer text, _viewer_user uuid default null) returns boolean
+language plpgsql security definer set search_path = public as $$
+declare _owner uuid; _n int; _today date := (now() at time zone 'Asia/Kolkata')::date;
+begin
+  select owner_id into _owner from public.rooms where id = _room and is_public = true;
+  if not found then return false; end if;
+  if _viewer_user is not null and _viewer_user = _owner then return false; end if;
+  if (select count(*) from public.room_views where viewer_key = _viewer and day = _today) >= 200 then return false; end if;
+  insert into public.room_views (room_id, viewer_key, day) values (_room, _viewer, _today) on conflict do nothing;
+  get diagnostics _n = row_count;
+  return _n > 0;
+end $$;
+
+-- Per-owner insights for the last N days (counts only). Saves come from app_saved_rooms, requests/offers from bookings.
+create or replace function public.room_insights(_owner uuid, _days int default 7) returns jsonb
+language plpgsql security definer stable set search_path = public as $$
+declare _d int := greatest(1, least(coalesce(_days, 7), 90)); _today date := (now() at time zone 'Asia/Kolkata')::date; _out jsonb;
+begin
+  with rs as (
+    select r.id, r.room_number, r.is_public, p.name as property
+      from public.rooms r left join public.properties p on p.id = r.property_id where r.owner_id = _owner
+  ), per as (
+    select rs.id as room_id, rs.room_number, rs.property, rs.is_public,
+      (select count(*) from public.room_views v where v.room_id = rs.id and v.day > _today - _d) as views,
+      (select count(*) from public.room_views v where v.room_id = rs.id and v.day <= _today - _d and v.day > _today - 2 * _d) as prev_views,
+      (select count(*) from public.app_saved_rooms s where s.room_id = rs.id and s.created_at > now() - make_interval(days => _d)) as saves,
+      (select count(*) from public.bookings b where b.room_id = rs.id and b.created_at > now() - make_interval(days => _d)) as requests,
+      (select count(*) from public.bookings b where b.room_id = rs.id and b.offered_rent is not null and b.created_at > now() - make_interval(days => _d)) as offers
+    from rs
+  )
+  select jsonb_build_object(
+    'days', _d,
+    'totals', jsonb_build_object('views', coalesce(sum(views), 0), 'prev_views', coalesce(sum(prev_views), 0),
+      'saves', coalesce(sum(saves), 0), 'requests', coalesce(sum(requests), 0), 'offers', coalesce(sum(offers), 0),
+      'public_rooms', coalesce(sum(case when is_public then 1 else 0 end), 0)),
+    'rooms', coalesce(jsonb_agg(jsonb_build_object('room_id', room_id, 'label', coalesce(property, '') || ' · ' || coalesce(room_number, ''),
+      'is_public', is_public, 'views', views, 'saves', saves, 'requests', requests, 'offers', offers) order by views desc, saves desc), '[]'::jsonb))
+  into _out from per;
+  return _out;
+end $$;
+
+-- Weekly summary (Mon 09:00 IST). Idempotent per owner per ISO week via claim_automation_slot. Counts only.
+create or replace function public.send_weekly_room_insights() returns int
+language plpgsql security definer set search_path = public as $$
+declare o record; ins jsonb; v int; pv int; s int; r int; best text; body text; _key text := to_char(now() at time zone 'Asia/Kolkata', 'IYYY-"W"IW'); n int := 0; delta text;
+begin
+  for o in select distinct owner_id from public.rooms where is_public = true and owner_id is not null loop
+    if not public.claim_automation_slot('weekly_room_insights', o.owner_id, _key, 'owner') then continue; end if;
+    begin
+      ins := public.room_insights(o.owner_id, 7);
+      v := (ins->'totals'->>'views')::int; pv := (ins->'totals'->>'prev_views')::int;
+      s := (ins->'totals'->>'saves')::int; r := (ins->'totals'->>'requests')::int;
+      if v = 0 and s = 0 and r = 0 then
+        body := 'Is hafte aapke listed rooms ko abhi koi view nahi mila. Photos/video verify karke aur rent-terms check karke listing behtar karein.';
+      else
+        delta := case when pv > 0 then ' (pichhle hafte ' || pv || ')' else '' end;
+        select (x->>'label') into best from jsonb_array_elements(ins->'rooms') x order by (x->>'views')::int desc limit 1;
+        body := 'Is hafte aapke rooms ko ' || v || ' logon ne dekha' || delta || ', ' || s || ' ne save kiya, ' || r || ' booking request aayi.'
+                || case when v > 0 and best is not null then ' Sabse zyada dekha gaya: ' || best || '.' else '' end;
+      end if;
+      perform public.notify_user(o.owner_id, 'room_insights_weekly', 'Aapke rooms is hafte', body, '/rentdesk');
+      perform public.finish_automation_slot('weekly_room_insights', o.owner_id, _key, 'completed', null, ins->'totals');
+      n := n + 1;
+    exception when others then
+      perform public.finish_automation_slot('weekly_room_insights', o.owner_id, _key, 'failed', sqlerrm, '{}'::jsonb);
+    end;
+  end loop;
+  delete from public.room_views where day < ((now() at time zone 'Asia/Kolkata')::date - 90); -- retention: 90 days
+  return n;
+end $$;
+
+-- A save is a strong signal: tell the owner (grouped: at most one per hour, never who saved it).
+create or replace function public.trg_room_saved() returns trigger language plpgsql security definer set search_path = public as $$
+declare _owner uuid; _rn text;
+begin
+  select owner_id, room_number into _owner, _rn from public.rooms where id = new.room_id;
+  if _owner is null or _owner = new.user_id then return new; end if;
+  if exists (select 1 from public.myr_notifications where user_id = _owner and kind = 'room_saved' and created_at > now() - interval '1 hour') then
+    return new;
+  end if;
+  perform public.notify_user(_owner, 'room_saved', 'Kisi ne aapka room save kiya', 'Room ' || coalesce(_rn, '') || ' ko ek tenant ne save kiya. Wo baad mein request bhej sakta hai.', '/rentdesk');
+  return new;
+exception when others then
+  return new; -- a notification problem must never block saving
+end $$;
+drop trigger if exists trg_room_saved on public.app_saved_rooms;
+create trigger trg_room_saved after insert on public.app_saved_rooms for each row execute function public.trg_room_saved();
+
+revoke all on function public.record_room_view(uuid, text, uuid) from public, anon, authenticated;
+revoke all on function public.room_insights(uuid, int) from public, anon, authenticated;
+revoke all on function public.send_weekly_room_insights() from public, anon, authenticated;
+grant execute on function public.record_room_view(uuid, text, uuid) to service_role;
+grant execute on function public.room_insights(uuid, int) to service_role;
+grant execute on function public.send_weekly_room_insights() to service_role;
+
+do $$ begin perform cron.unschedule('weekly-room-insights'); exception when others then null; end $$;
+do $$ begin perform cron.schedule('weekly-room-insights', '30 3 * * 1', 'select public.send_weekly_room_insights()'); exception when others then null; end $$;
