{
  "expo": {
    "name": "RentDesk",
    "slug": "rentdesk",
    "scheme": "rentdesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f4fd8"
    },
    "android": {
      "package": "in.rentalos.rentdesk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2f4fd8"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.rentalos.rentdesk",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "RentDesk aapke property aur payment ki photo ke liye gallery use karta hai.",
          "cameraPermission": "Property ki live photo kheenchne ke liye camera chahiye."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Photo property par hi li gayi hai ye verify karne ke liye location chahiye."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}