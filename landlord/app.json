{
  "expo": {
    "name": "RentDesk",
    "slug": "rentdesk",
    "scheme": "rentdesk",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2f4fd8"
    },
    "android": {
      "package": "in.rentalos.rentdesk",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2f4fd8"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "in.rentalos.rentdesk",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "RentDesk aapke property aur payment ki photo ke liye gallery use karta hai.",
          "cameraPermission": "Property ki live photo aur room video record karne ke liye camera chahiye.",
          "microphonePermission": "Room video record karne ke liye microphone chahiye."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Photo property par hi li gayi hai ye verify karne ke liye location chahiye."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "77037720-6b44-41c4-b8b7-f8f1ead37c62"
      },
      "router": {}
    },
    "owner": "arpityuk"
  }
}
